# Host port overrides for `docker compose up` (local development only).
#
# These only change which port each service is published on *on your machine* -
# container-to-container traffic (e.g. the app talking to MinIO at
# http://minio:9000) always uses the container's default port and is
# unaffected by these values. Copy this file to `.env` and adjust as needed,
# e.g. if you already have Postgres/Redis/MinIO running locally on the
# defaults below.
#
# `start-tracker-docker.sh`/`.bat` read this file too (a value already exported in your shell
# wins over the file, same precedence as Compose), so the URLs they wait for and open follow
# whatever you set here.
#
# Example, to work around a MinIO port conflict:
#   MINIO_PORT=19000 MINIO_CONSOLE_PORT=19001 docker compose up
#
# If a port is already taken, find the owner before overriding:
#   docker ps -a --filter publish=5173   # a container - note that one-off `docker compose run`
#                                        # containers survive a plain `docker compose down`
#   lsof -nP -iTCP:5173 -sTCP:LISTEN     # a process on the host

DB_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379
APP_PORT=8080
FRONTEND_PORT=5173
